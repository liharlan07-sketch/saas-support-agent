# 配置通过进程环境传入；应用不自动加载 .env。
# 不填写真实凭证。仅供本机单进程合成演示。
SAAS_DEMO_TOKENS=
SAAS_DATABASE=runtime/http-demo.sqlite3
SAAS_RAG_ENABLED=0
SAAS_RAG_ROOT=runtime/rag
SAAS_POLICY_CATALOG=data/merchant_policies/catalog.json
# 客户端脚本单独使用；不要提交实际值。
SAAS_DEMO_CLIENT_TOKEN=

# 3B：默认关闭。厂商、地址、模型、预算须另行确认；本轮不调用真实 API。
SAAS_LLM_ENABLED=0
# 完整 HTTPS 请求地址；实现约定 messages -> choices[0].message.content JSON 协议。
SAAS_LLM_ENDPOINT=
SAAS_LLM_MODEL=
SAAS_LLM_API_KEY=
